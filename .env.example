# Copy this file to .env.local and adjust the values.
# Public variables (NEXT_PUBLIC_*) end up in the browser bundle: never put secrets in them.

# Canonical site URL (used for metadata, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Set to true at build time to keep /dev/* preview pages
# (tokens, fonts, ui) in a production build. Always on in `next dev`.
ENABLE_DEV_PAGES=false
